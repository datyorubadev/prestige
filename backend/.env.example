# ╔══════════════════════════════════════════════════════════════════╗
# ║  Prestige — Backend Environment Variables                      ║
# ║  Copy to .env and fill in your values.                         ║
# ║  For production (Render): set these in the dashboard instead.   ║
# ╚══════════════════════════════════════════════════════════════════╝

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-strong-random-64-chars
DATABASE_URL=sqlite:///./support_portal.db
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Error tracking (Sentry) ---
# Set a DSN to enable error reporting. Empty = disabled (local dev).
SENTRY_DSN=

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Groq ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- AI Replies ---
MAX_REPLY_WORDS=200
AI_GUARDRAILS=true

# --- Vector DB ---
CHROMA_DATA_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
GRAPH_CHECKPOINTER=redis

# --- Email ---
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@portal.ng

# --- Rate limiting ---
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_INGEST_PER_MIN=5
RATE_LIMIT_ADMIN_PER_MIN=30

# --- Super Admin bootstrap (first-run seed) ---
SUPER_ADMIN_EMAIL=root@portal.ng
SUPER_ADMIN_PASSWORD=change-me-now

# --- Invites ---
INVITE_EXPIRE_DAYS=3

# --- Impersonation ---
IMPERSONATION_EXPIRE_MINUTES=30

# ══════════════════════════════════════════════════════════════════
# PRODUCTION NOTES (Render / Vercel / Neon / Upstash):
#
# DATABASE_URL → Use Neon PostgreSQL connection string:
#   postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# REDIS_URL → Use Upstash Redis URL:
#   rediss://xxxx:xxxx@usw1-xxxx.upstash.io:6379
#
# CORS_ORIGINS → Your Vercel frontend URL:
#   https://your-app.vercel.app
#
# GRAPH_CHECKPOINTER → Set to "memory" on Render (no Redis persistence needed)
#
# CHROMA_DATA_DIR → Set to "/tmp/chroma_data" on Render (ephemeral filesystem)
# ══════════════════════════════════════════════════════════════════
